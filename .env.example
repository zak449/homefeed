# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Auth.js core ────────────────────────────────────────────────────────
AUTH_SECRET=""           # openssl rand -base64 32
AUTH_URL="https://gwaky.com"

# ─── OAuth providers (each is optional — provider only loads when both
#     vars for that provider are set) ──────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ─── Email magic link via Resend ─────────────────────────────────────────
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="noreply@gwaky.com"

# ─── Vercel Blob (avatar uploads) ────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
