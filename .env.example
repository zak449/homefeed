# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/homefeed"

# Email — get a free API key at https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="HomeFeed <hello@yourdomain.com>"

# ---- Optional: Real Listing Data APIs ----
# Zillow Bridge Interactive API
# Apply at https://bridgeinteractive.com
ZILLOW_API_KEY=""
ZILLOW_API_BASE_URL="https://api.bridgeinteractive.com/v2"
ZILLOW_DATASET_ID=""

# MLS / RESO Web API (Spark API is a popular gateway)
# Apply through your local MLS board for IDX credentials
MLS_API_URL="https://replication.sparkapi.com/v1/listings"
MLS_API_KEY=""

# Leave empty to use built-in seed data (no real API calls)
USE_LIVE_DATA="false"
