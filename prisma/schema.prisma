generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id             String   @id @default(cuid())
  source         String   // "rentcast" | "realtor" | "seed"
  sourceId       String
  status         String   @default("active") // "active" | "pending" | "sold" | "off_market"
  address        String
  city           String
  state          String
  zip            String
  neighborhood   String?
  latitude       Float?
  longitude      Float?
  price          Int
  priceHistory   Json?    // [{date, price, event}]
  listingType    String   // "sale" | "rent"
  propertyType   String   // "house" | "condo" | "townhouse" | "apartment"
  bedrooms       Int?
  bathrooms      Float?
  sqft           Int?
  lotSqft        Int?
  yearBuilt      Int?
  parking        String?
  description    String?
  photos         String[]
  agentName      String?
  agentPhone     String?
  agentEmail     String?
  agentPhoto     String?
  agentBrokerage String?
  listingUrl     String?
  cachedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments      Comment[]
  subscriptions EmailSubscription[]

  @@unique([source, sourceId])
  @@index([city, listingType])
  @@index([status, city])
  @@index([price])
}

model Comment {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Anonymous fields (kept for legacy comments). New comments use userId.
  name      String
  email     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  // accounts-comments-notifications additions:
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentThread")
  likeCount Int      @default(0)
  isRedFlag Boolean  @default(false)
  editedAt  DateTime?
  likes     CommentLike[]

  reactions Reaction[]

  @@index([listingId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model Reaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  email     String
  type      String   // "❤️" | "🔥" | "😂" | "😮" | "💀"
  createdAt DateTime @default(now())

  @@unique([commentId, email, type])
}

model EmailSubscription {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([listingId, email])
}

// ── Newsletter / Marketing Subscriptions ───────────────────

model Subscriber {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?
  source          String?  // "hero" | "inline" | "footer" | "sticky" | "api"
  klaviyoId       String?  // Klaviyo profile ID for syncing
  listingAlerts   Boolean  @default(true)
  hotTakesDigest  Boolean  @default(true)
  commentReplies  Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
}

// ── Analytics & User Profiles ──────────────────────────────

model UserProfile {
  id            String   @id @default(cuid())
  anonId        String   @unique  // browser fingerprint / cookie ID
  latitude      Float?
  longitude     Float?
  city          String?
  state         String?
  zip           String?
  searchRadius  Int      @default(25) // miles
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events   AnalyticsEvent[]

  @@index([city, state])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonId    String   // always set even if user record doesn't exist yet
  type      String   // "page_view" | "search" | "listing_view" | "comment" | "reaction"
  data      Json?    // flexible payload: { city, query, listingId, etc. }
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  @@index([anonId, createdAt])
  @@index([type, createdAt])
}

// ── Zip-Verified Community System ─────────────────────────

model ZipCommunity {
  id              String   @id @default(cuid())
  zipCode         String   @unique
  city            String
  state           String
  memberCount     Int      @default(0)
  activeDiscussions Int    @default(0)
  totalTakes      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  residents       VerifiedResident[]
  questions       NeighborQuestion[]
  alerts          CommunityAlert[]
}

model VerifiedResident {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  zipCode       String
  community     ZipCommunity @relation(fields: [zipCode], references: [zipCode])
  address       String   // stored but NEVER shown publicly
  badge         String   @default("newcomer") // newcomer | local | veteran | legend
  reputation    Int      @default(0)
  verifiedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions     NeighborQuestion[]
  answers       NeighborAnswer[]
  alerts        CommunityAlert[]

  @@index([zipCode])
}

model NeighborQuestion {
  id          String   @id @default(cuid())
  question    String   @db.Text
  category    String   @default("general") // property | block | area | schools | safety
  zipCode     String
  community   ZipCommunity @relation(fields: [zipCode], references: [zipCode])
  listingId   String?  // optional — can be about a specific property
  askedById   String?
  askedBy     VerifiedResident? @relation(fields: [askedById], references: [id])
  askedByName String?  // for non-verified users
  askerEmail  String?  // email for answer notifications
  upvotes     Int      @default(0)
  status      String   @default("open") // open | answered | closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers     NeighborAnswer[]

  @@index([zipCode, createdAt])
  @@index([listingId])
}

model NeighborAnswer {
  id            String   @id @default(cuid())
  content       String   @db.Text
  questionId    String
  question      NeighborQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answeredById  String
  answeredBy    VerifiedResident @relation(fields: [answeredById], references: [id])
  upvotes       Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([questionId, createdAt])
}

model CommunityAlert {
  id          String   @id @default(cuid())
  content     String   @db.Text
  type        String   @default("tip") // warning | tip | update
  zipCode     String
  community   ZipCommunity @relation(fields: [zipCode], references: [zipCode])
  listingId   String?
  createdById String
  createdBy   VerifiedResident @relation(fields: [createdById], references: [id])
  isActive    Boolean  @default(true)
  expiresAt   DateTime? // auto-set when listing sells
  createdAt   DateTime @default(now())

  @@index([zipCode, isActive])
  @@index([listingId])
}

// Track when we last synced a city so we don't burn API calls
model CitySync {
  id        String   @id @default(cuid())
  city      String
  state     String?
  lastSync  DateTime @default(now())
  rentcastCount  Int @default(0)
  realtorCount   Int @default(0)

  @@unique([city, state])
  @@index([lastSync])
}

// ───────────────────────────────────────────────────────────────────────────
// accounts-comments-notifications: User accounts, sessions, profiles,
// notifications, saved listings, and per-user comment likes.
// ───────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  bio             String?
  avatarUrl       String?
  streakCount     Int       @default(0)
  streakUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── onboarding additions (Tier 1) ─────────────────────────
  role                        Role?      // null until onboarding completes
  markets                     String[]   @default([]) // metro codes, e.g. ["nyc","sf"]
  neighborhoods               String[]   @default([]) // free-text neighborhood names
  onboardingCompletedAt       DateTime?

  // ── onboarding additions (Tier 2) ─────────────────────────
  buyRentIntent               BuyRentIntent?
  intentTimeline              IntentTimeline?
  budgetBand                  String?    // bucketed string, e.g. "rent_2k_3k", "buy_500k_750k"
  referralSource              ReferralSource?

  // ── consent (granular) ────────────────────────────────────
  tosAcceptedAt               DateTime?
  privacyPolicyAcceptedAt     DateTime?
  marketingConsent            Boolean    @default(false)
  marketingConsentAt          DateTime?
  personalizationConsent      Boolean    @default(true)
  personalizationConsentAt    DateTime?
  pushConsent                 Boolean    @default(false)
  pushConsentAt               DateTime?
  dataProcessingConsentedAt   DateTime?

  // ── privacy toggles (per-field public/private) ────────────
  showRolePublicly            Boolean    @default(true)
  showMarketsPublicly         Boolean    @default(true)
  showWatchlistPublicly       Boolean    @default(false)
  // budgetBand has NO public toggle — never shown publicly.

  // ── notification prefs ────────────────────────────────────
  emailDigestCadence          DigestCadence @default(WEEKLY)

  // ── relations (existing) ──────────────────────────────────
  accounts      Account[]
  sessions      Session[]
  comments      Comment[]
  likes         CommentLike[]
  notifications Notification[]
  savedListings SavedListing[]

  // ── relations (onboarding) ────────────────────────────────
  watchlist                WatchlistItem[]
  consentLogs              ConsentLog[]
  dataExportRequests       DataExportRequest[]
  accountDeletionRequest   AccountDeletionRequest?

  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "comment_reply" | "comment_like" | "mention" | "saved_listing_update" | "system"
  title     String
  body      String?  @db.Text
  link      String?
  read      Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@index([userId])
}

// ───────────────────────────────────────────────────────────────────────────
// Onboarding: enums + GDPR/CCPA models
// ───────────────────────────────────────────────────────────────────────────

enum Role {
  RENTER
  BUYER
  SELLER
  AGENT
  BROKER
  INVESTOR
  PROPERTY_MANAGER
  JOURNALIST
  CURIOUS
}

enum BuyRentIntent {
  RENTING
  BUYING
  SELLING
  BROWSING
}

enum IntentTimeline {
  WITHIN_30_DAYS
  WITHIN_6_MONTHS
  JUST_BROWSING
}

enum ReferralSource {
  TIKTOK
  X_TWITTER
  REDDIT
  FRIEND
  ARTICLE
  SEARCH
  OTHER
}

enum DigestCadence {
  OFF
  DAILY
  WEEKLY
  MONTHLY
}

enum ConsentType {
  TOS
  PRIVACY_POLICY
  MARKETING
  PERSONALIZATION
  PUSH
  DATA_PROCESSING
}

/// Canonical audit log of every consent action a user takes.
/// Required for GDPR/CCPA defensibility. We write a row on signup,
/// on every toggle in /profile/edit, and on revocations.
model ConsentLog {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConsentType
  value       Boolean     // true = granted, false = revoked/declined
  context     String?     // "signup_wizard", "profile_edit", "tier2_modal"
  ipAddress   String?     // hashed at write time, see lib/consent/hashIp.ts
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([userId, type, createdAt])
}

/// User's saved buildings/addresses. Private by default.
model WatchlistItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId    String?  // FK to Building when we have one; nullable for free-text addresses
  freeTextLabel String?  // user-typed address before we have a Building row
  isPublic      Boolean  @default(false) // per-item privacy toggle
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([buildingId])
}

/// User-initiated GDPR/CCPA data export request. Worker job picks
/// these up and emails a download link.
model DataExportRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING | RUNNING | READY | FAILED
  downloadUrl String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}

/// Soft-deletion request with a 30-day grace period before hard delete.
model AccountDeletionRequest {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt  DateTime  @default(now())
  scheduledFor DateTime  // requestedAt + 30 days
  reason       String?
  cancelledAt  DateTime?

  @@index([scheduledFor])
}
