generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id             String   @id @default(cuid())
  source         String   // "rentcast" | "realtor" | "seed"
  sourceId       String
  status         String   @default("active") // "active" | "pending" | "sold" | "off_market"
  address        String
  city           String
  state          String
  zip            String
  neighborhood   String?
  latitude       Float?
  longitude      Float?
  price          Int
  priceHistory   Json?    // [{date, price, event}]
  listingType    String   // "sale" | "rent"
  propertyType   String   // "house" | "condo" | "townhouse" | "apartment"
  bedrooms       Int?
  bathrooms      Float?
  sqft           Int?
  lotSqft        Int?
  yearBuilt      Int?
  parking        String?
  description    String?
  photos         String[]
  agentName      String?
  agentPhone     String?
  agentEmail     String?
  agentPhoto     String?
  agentBrokerage String?
  listingUrl     String?
  cachedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comments      Comment[]
  subscriptions EmailSubscription[]

  @@unique([source, sourceId])
  @@index([city, listingType])
  @@index([status, city])
  @@index([price])
}

model Comment {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  email     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  reactions Reaction[]

  @@index([listingId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  email     String
  type      String   // "❤️" | "🔥" | "😂" | "😮" | "💀"
  createdAt DateTime @default(now())

  @@unique([commentId, email, type])
}

model EmailSubscription {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([listingId, email])
}

// ── Newsletter / Marketing Subscriptions ───────────────────

model Subscriber {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?
  source          String?  // "hero" | "inline" | "footer" | "sticky" | "api"
  klaviyoId       String?  // Klaviyo profile ID for syncing
  listingAlerts   Boolean  @default(true)
  hotTakesDigest  Boolean  @default(true)
  commentReplies  Boolean  @default(true)
  smsEnabled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([email])
}

// ── Analytics & User Profiles ──────────────────────────────

model UserProfile {
  id            String   @id @default(cuid())
  anonId        String   @unique  // browser fingerprint / cookie ID
  latitude      Float?
  longitude     Float?
  city          String?
  state         String?
  zip           String?
  searchRadius  Int      @default(25) // miles
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events   AnalyticsEvent[]

  @@index([city, state])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonId    String   // always set even if user record doesn't exist yet
  type      String   // "page_view" | "search" | "listing_view" | "comment" | "reaction"
  data      Json?    // flexible payload: { city, query, listingId, etc. }
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  @@index([anonId, createdAt])
  @@index([type, createdAt])
}

// Track when we last synced a city so we don't burn API calls
model CitySync {
  id        String   @id @default(cuid())
  city      String
  state     String?
  lastSync  DateTime @default(now())
  rentcastCount  Int @default(0)
  realtorCount   Int @default(0)

  @@unique([city, state])
  @@index([lastSync])
}
